# Xojo IDE state (per-user, binary)
*.xojo_uistate

# Build output (UseBuildsFolder=True puts builds in "Builds - <Project>")
Builds*/
Build/

# Xojo agentic-mode handshake files
XojoRunProject.txt
XojoCompileErrors.txt

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# IDE leftovers when an item with child files is replaced
*.obsolete_*/
